# Development defaults only. Replace with unique random secrets before exposure.
UCF_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
UCF_ADMIN_API_KEY=replace-with-a-long-random-admin-secret
UCF_NODE_LEASE_SECONDS=45

# Optional OpenTelemetry OTLP/HTTP traces endpoint, e.g. http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
